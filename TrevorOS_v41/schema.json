{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trevoros.v4.1/schema.json",
  "title": "TrevorOS v4.1 Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "metadata",
    "content"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "4.1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "status",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "log.entry",
            "reflection",
            "action.item",
            "action.step",
            "project",
            "milestone",
            "objective",
            "key_result",
            "decision",
            "risk",
            "issue",
            "idea",
            "knowledge.note",
            "meeting.note",
            "research.source",
            "resource",
            "habit",
            "template",
            "review",
            "metric"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "blocked",
            "done",
            "archived"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target_id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "depends_on",
                  "blocks",
                  "parent",
                  "child",
                  "relates_to",
                  "duplicate_of"
                ]
              },
              "target_id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "uniqueItems": true
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "done"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "done": {
                "type": "boolean"
              },
              "due_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timestamp",
              "note"
            ],
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "location": {
              "type": "string"
            },
            "timeframe": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "people": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
